{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // Same aliasing as `apps/site`: resolve the library from source, not from
    // its `exports`. `remotion.config.ts` repeats these for webpack, which is
    // what actually resolves them at render time.
    //
    // `sketchy-blobatar/animate` is not a public entry point. It is aliased here because
    // the timing solver needs the seeded motion offsets to schedule a blink, and
    // reproducing those ranges in this app would be a second source of truth
    // that drifts silently the first time a range is retuned.
    "paths": {
      "sketchy-blobatar": ["../../packages/sketchy-blobatar/src/index.ts"],
      "sketchy-blobatar/blob": ["../../packages/sketchy-blobatar/src/blob.ts"],
      "sketchy-blobatar/uri": ["../../packages/sketchy-blobatar/src/uri.ts"],
      "sketchy-blobatar/expression": ["../../packages/sketchy-blobatar/src/expression.ts"],
      "sketchy-blobatar/react": ["../../packages/sketchy-blobatar/src/react.tsx"],
      "sketchy-blobatar/animate": ["../../packages/sketchy-blobatar/src/animate.ts"],
      "sketchy-blobatar/motion.css": ["../../packages/sketchy-blobatar/src/motion.css"]
    }
  },
  "include": ["."]
}
